# ============================================================
# RAGStudio 环境变量配置（示例）
# ============================================================
# 将此文件复制为 .env 并填入实际值
# cp .env-example .env
# ============================================================

# ----------------------
# 数据库配置（PostgreSQL）
# ----------------------
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=jdbc:postgresql://localhost:5432/ragstudio

# ----------------------
# Redis 配置
# ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Embedding 结果二级缓存（跨重启/多实例共享，避免重启后重复 query 再付冷调用 ~9s）
# true=本地内存 + Redis；false=仅本地内存。Redis 不可用时自动降级为纯本地缓存
EMBEDDING_CACHE_REDIS=true
# 缓存 TTL（小时）。模型服务端升级/输出漂移时，过长的 TTL 会冻结陈旧向量
# 导致选库/检索排名失真（曾因 24h TTL 配合模型更新引发选库系统性错选）。建议 ≤ 6h
# EMBEDDING_CACHE_TTL_HOURS=6

# ----------------------
# RocketMQ 配置
# ----------------------
ROCKETMQ_NAMESERVER=localhost:9876

# ----------------------
# RustFS (S3 兼容对象存储) 配置
# ----------------------
RUSTFS_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=your_access_key
RUSTFS_SECRET_KEY=your_secret_key

# 是否保存ai对话日志，生产环境务必关闭！
SAVE_AI_LOG=false

# RAG 检索审计日志（记录每次检索的文档名/RRF 分/重排顺序，按日落 logs/rag-search/），排查检索问题时开启
RAG_SEARCH_AUDIT_LOG=false

# ----------------------
# 服务端口
# ----------------------
SERVER_PORT=9090

# ----------------------
# 文件上传限制
# ----------------------
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=100MB

# ----------------------
# 语义裁剪服务
# ----------------------
# 语义裁剪（句子级 Chunk 裁剪）开关
# 开启时需先下载 bge-small-zh-v1.5 量化模型到 RAG_CROP_MODEL_PATH（默认关闭；
# 默认路径为 <RAGSTUDIO_DATA_DIR>/models/bge-small-zh-v1.5，项目内旧模型目录启动时自动搬移）
RAG_CROP_ENABLED=false
# RAG_CROP_MODEL_PATH=
RAG_CROP_THRESHOLD=0.35

# ----------------------
# Graph RAG（实体关系图谱）
# ----------------------
# 总开关与抽取模型在后管「知识图谱」页动态控制（建表已含在 resources/database/schema_all.sql，
# 见 docs/graph-rag-design.md），此处无需配置

# ----------------------
# Docker 沙箱
# ----------------------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=sandbox:latest

# ----------------------
# 运行时数据目录（RAGStudioData）
# ----------------------
# 所有可变数据的根目录：SKILL 工作区 / 检索审计日志 / AI 对话日志 / 本地模型 / 本地摄取白名单(uploads)。
# 缺省自动定位：项目内运行（IDEA / mvnw）→ 与项目同级的 ../RAGStudioData；
# JAR 运行 → JAR 所在目录下的 RAGStudioData。JAR 部署建议把 .env 也放到 RAGStudioData/ 下（自动加载）。
# 留空即自动定位；显式指定时建议绝对路径
RAGSTUDIO_DATA_DIR=

# ----------------------
# SKILL 技能目录与版本管理
# ----------------------
# SKILL 工作区（DB 版本内容的物化目标，script/command 类型技能的沙箱挂载源）。
# 默认 <RAGSTUDIO_DATA_DIR>/skills，一般无需配置；容器部署时把 RAGSTUDIO_DATA_DIR 挂载为持久卷。
# 迁移：项目根旧 skills/ 目录启动时自动收编入 DB；旧 data/skills、logs/rag-search、AILog、
# resources/models/bge-small-zh-v1.5 启动时自动搬移到 RAGStudioData 下
# SKILLS_DIR=
# 入库限制：单文件大小 / 单版本总大小 / 版本保留数（0 = 不限制）
SKILL_MAX_FILE_SIZE=20MB
SKILL_MAX_TOTAL_SIZE=64MB
SKILL_MAX_VERSIONS=0

# ----------------------
# 会话令牌过期时间（秒，默认 30 天）
# ----------------------
TOKEN_TIMEOUT=2592000

# ----------------------
# 并发对话限制
# ----------------------
MAX_CONCURRENT=1

# ----------------------
# 链路追踪
# ----------------------
TRACE_ENABLED=true

# ----------------------
# 默认检索数量
# ----------------------
DEFAULT_TOP_K=10

# ----------------------
# 演示模式
# ----------------------
DEMO_MODE=false

# ----------------------
# 默认头像 URL
# ----------------------
DEFAULT_AVATAR_URL=https://avatars.githubusercontent.com/u/583231?v=4

# ----------------------
# MinerU 文档解析服务（PDF 公式/表格/扫描件 → Markdown）
# 远程默认指向 mineru.net 官方 Agent 轻量 API（免费免 Token，≤10MB、≤20 页、IP 限频）
# 开启远程解析：MINERU_ENABLED=true，并在系统设置页启用「远程 MinerU」
# ----------------------
MINERU_ENABLED=false
MINERU_LOCAL_BASE_URL=
MINERU_REMOTE_BASE_URL=https://mineru.net/api/v1/agent
MINERU_REMOTE_API_KEY=
MINERU_REMOTE_LANG=ch
MINERU_TIMEOUT_SECONDS=300
